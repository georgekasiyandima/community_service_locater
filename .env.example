# Server
PORT=3000
NODE_ENV=development

# Pilot ward (do not hardcode ward-specific logic elsewhere)
DEFAULT_WARD_ID=mutasa-ward-14

# Comma-separated WhatsApp numbers in E.164 format.
# These numbers can send UPDATE / LIST admin commands.
ADMIN_PHONES=+263771000001,+263771000002

# Simple PIN for the web admin console (not a production auth system)
ADMIN_PIN=2468

# Salt used when hashing phone numbers in the query log
LOG_SALT=change-me-before-any-real-pilot

# Twilio WhatsApp (optional — the web demo works without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
